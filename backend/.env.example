# NYAYASETU Backend Environment Variables
# Copy this file to .env and update with your actual values

# Application
APP_NAME=NYAYASETU
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For SQLite (development):
DATABASE_URL=sqlite:///./nyayasetu.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/nyayasetu

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-secret-key-here-at-least-32-characters-long-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - Update with your frontend URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# AI Services
# Leave empty for DEMO_MODE
OPENAI_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# Session Management
SESSION_TTL_HOURS=24

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/nyayasetu.log

# Demo Mode - Set to True to run without paid AI APIs
DEMO_MODE=False
